---
import '../styles/global.css';
import Comparador from '../components/Comparador.jsx';
import fs from 'node:fs';
import path from 'node:path';

// Logos de los supermercados: cualquier archivo public/logos/<id>.(png|svg|webp|jpg) se usa solo.
const logos = {};
const dirLogos = path.join(process.cwd(), 'public', 'logos');
if (fs.existsSync(dirLogos)) {
  for (const f of fs.readdirSync(dirLogos)) {
    const m = f.match(/^(.+)\.(png|svg|webp|jpe?g)$/i);
    if (m) logos[m[1].toLowerCase()] = f;
  }
}
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Comparador de Súper</title>
    <meta name="description" content="Compará el precio de tu lista de compras en los principales supermercados de Argentina." />
    <meta name="theme-color" content="#faf6ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#2a1327" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon.ico" sizes="48x48">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="theme-color" content="#3d1640">

    <meta property="og:type" content="website">
    <meta property="og:title" content="Comparador de Súper">
    <meta property="og:description" content="Compará tu lista de compras en Coto, Día, Jumbo, Carrefour y Disco.">
    <meta property="og:locale" content="es_AR">
    <meta property="og:image" content="https://donde-comprar-nine.vercel.app/og-image.png">
    <meta name="twitter:card" content="summary_large_image">
    <script is:inline>
      // Aplica el tema elegido antes de pintar para evitar el parpadeo. Sin elección, manda el del sistema.
      try { var t = localStorage.getItem('super-tema'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400..800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Comparador client:load logos={logos} />
    {import.meta.env.PROD && (
      <script is:inline define:vars={{ base: import.meta.env.BASE_URL }}>
        // Service worker: la app y los últimos precios quedan disponibles sin conexión.
        if ('serviceWorker' in navigator) window.addEventListener('load', function () { navigator.serviceWorker.register(base + 'sw.js').catch(function () {}); });
      </script>
    )}
  </body>
</html>
